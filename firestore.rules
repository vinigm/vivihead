rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /days/{docId} {
      allow read, write: if
        request.auth != null
        && request.auth.token.email in ['vinigm@gmail.com', 'victoria.cerutti@gmail.com']
        && docId.matches("^(vivi|vini)_\\d{4}-\\d{2}-\\d{2}$");
    }
  }
}
